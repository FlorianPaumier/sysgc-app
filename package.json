{
    "name": "sysgc-app",
    "private": true,
    "description": "SysGC — E2E (Playwright) tooling. The app itself is a server-rendered Symfony app; this package exists only to run the Playwright suite (specs/09-tests.md, CLAUDE.md).",
    "type": "module",
    "scripts": {
        "test": "npm run test:frontend",
        "test:frontend": "node --test frontend-tests/*.test.js",
        "coverage:frontend": "node --experimental-test-coverage --test-coverage-include=assets/controllers/nav_controller.js --test-coverage-include=assets/controllers/sidebar_controller.js --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 frontend-tests/controllers.test.js",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "e2e:install": "playwright install --with-deps"
    },
    "devDependencies": {
        "@hotwired/stimulus": "^3.2.2",
        "@playwright/test": "^1.55.0",
        "jsdom": "^27.0.0"
    }
}
