{% extends 'app_base.html.twig' %}
{% block title %}Nouvelle facture{% endblock %}
{% block body %}<section class="container py-4" data-controller="invoice-milestone" data-invoice-milestone-budget-value="{{ budget }}"><a href="{{ path('app_invoice_index', {id: project.id}) }}">← Factures</a><h1 class="h2">Nouvelle facture</h1><p>Facturation progressive par jalon · Budget : <strong>{{ budget|number_format(2, ',', ' ') }} $</strong></p>{{ form_start(form) }}{{ form_row(form.milestoneName) }}{{ form_row(form.percentage, {attr: {'data-invoice-milestone-target': 'percentage', 'data-action': 'input->invoice-milestone#update'}}) }}{{ form_row(form.amount, {attr: {'data-invoice-milestone-target': 'amount', 'readonly': true}}) }}<p aria-live="polite">Montant calculé : <strong data-invoice-milestone-target="preview">0,00 $</strong></p>{{ form_row(form.save) }}{{ form_end(form) }}</section>{% endblock %}
