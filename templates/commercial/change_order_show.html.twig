{% extends 'app_base.html.twig' %}
{% block title %}{{ changeOrder.title }}{% endblock %}
{% block body %}<section class="container py-4"><a href="{{ path('app_change_order_index', {id: project.id}) }}">← Avenants</a><h1 class="h2">{{ changeOrder.title }}</h1>{% if isArchived %}<p role="alert" class="alert alert-warning">Ce chantier est archivé. Ce dossier est en lecture seule.</p>{% endif %}<p>{{ changeOrder.description }}</p><dl><dt>Impact financier</dt><dd>{{ changeOrder.costImpact|number_format(2, ',', ' ') }} $</dd><dt>Échéancier</dt><dd>{{ changeOrder.scheduleImpactDays }} jours</dd><dt>Statut</dt><dd><twig:StatusBadge :status="changeOrder.status.value" :label="changeOrder.status.value|replace({'pending': 'En attente', 'approved': 'Approuvé', 'rejected': 'Rejeté', 'invoiced': 'Facturé'})" /></dd></dl>{% if form %}<form method="post" action="{{ path('app_change_order_edit', {id: project.id, changeOrderId: changeOrder.id}) }}">{{ form_widget(form) }}<input type="hidden" name="_token" value="{{ csrf_token('change-order-' ~ changeOrder.id) }}"><button class="btn btn-primary" type="submit">Enregistrer les modifications</button></form><div class="change-order-actions">{% if changeOrder.status.value == 'pending' %}<form method="post" action="{{ path('app_change_order_edit', {id: project.id, changeOrderId: changeOrder.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('change-order-' ~ changeOrder.id) }}"><button name="workflow_action" value="approve" class="btn" type="submit">Approuver</button><input name="rejection_reason" aria-label="Motif du rejet" placeholder="Motif (facultatif)"><button name="workflow_action" value="reject" class="btn" type="submit">Rejeter</button></form>{% elseif changeOrder.status.value == 'approved' %}<form method="post" action="{{ path('app_change_order_edit', {id: project.id, changeOrderId: changeOrder.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('change-order-' ~ changeOrder.id) }}"><button name="workflow_action" value="invoiced" class="btn" type="submit">Marquer facturé</button></form>{% elseif changeOrder.status.value == 'rejected' %}<form method="post" action="{{ path('app_change_order_edit', {id: project.id, changeOrderId: changeOrder.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('change-order-' ~ changeOrder.id) }}"><button name="workflow_action" value="reopen" class="btn" type="submit">Rouvrir</button></form>{% endif %}</div>{% endif %}<twig:AuditTrail :trail="changeOrder.auditTrail" /></section>{% endblock %}
