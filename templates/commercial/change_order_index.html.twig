{% extends 'app_base.html.twig' %}
{% block title %}Avenants · {{ project.address }}{% endblock %}
{% block body %}
<section class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h2">Avenants</h1>{% if not isArchived %}<a class="btn btn-primary" href="{{ path('app_change_order_new', {id: project.id}) }}">Nouvel avenant</a>{% endif %}</div>
  {% if isArchived %}<p role="alert" class="alert alert-warning">Ce chantier est archivé. Les avenants sont accessibles en lecture seule.</p>{% endif %}
  {% for changeOrder in project.changeOrders %}
    <article class="card mb-2"><div class="card-body d-flex justify-content-between align-items-center"><div><strong>{{ changeOrder.title }}</strong><span class="d-block">{{ changeOrder.costImpact|number_format(2, ',', ' ') }} $ · {{ changeOrder.scheduleImpactDays }} j</span></div><div><twig:StatusBadge :status="changeOrder.status.value" :label="changeOrder.status.value|replace({'pending': 'En attente', 'approved': 'Approuvé', 'rejected': 'Rejeté', 'invoiced': 'Facturé'})" /> <a href="{{ path('app_change_order_show', {id: project.id, changeOrderId: changeOrder.id}) }}">Voir</a></div></div></article>
  {% else %}<p class="text-muted">Aucun avenant pour ce chantier.</p>{% endfor %}
</section>
{% endblock %}
