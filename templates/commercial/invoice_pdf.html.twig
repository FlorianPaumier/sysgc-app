{% set subtotal = invoice.amount|number_format(2, '.', '') %}{% set tps = (subtotal * 0.05)|number_format(2, '.', '') %}{% set tvq = (subtotal * 0.09975)|number_format(2, '.', '') %}{% set total = (subtotal * 1.14975)|number_format(2, '.', '') %}<!doctype html><html lang="fr"><head><meta charset="utf-8"><style>body{font-family:DejaVu Sans,sans-serif;color:#172033}h1{font-size:24px}.total{font-size:20px;font-weight:bold}td{padding:5px 16px 5px 0}</style></head><body><h1>FACTURE</h1><p><strong>Chantier :</strong> {{ invoice.project.address }}<br><strong>Client :</strong> {{ invoice.project.clientName }}</p><p><strong>Jalon :</strong> {{ invoice.milestoneName }} ({{ invoice.percentage }} %)</p><table><tr><td>Sous-total</td><td>{{ subtotal }} $ CAD</td></tr><tr><td>TPS (5 %)</td><td>{{ tps }} $</td></tr><tr><td>TVQ (9,975 %)</td><td>{{ tvq }} $</td></tr><tr class="total"><td>Total TTC</td><td>{{ total }} $ CAD</td></tr></table><p>Conditions de paiement : Net 30 jours</p><footer>Document généré par SysGC</footer></body></html>
