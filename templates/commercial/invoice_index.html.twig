{% extends 'app_base.html.twig' %}
{% block title %}Factures · {{ project.address }}{% endblock %}
{% block body %}
<section class="container py-4">
  <a href="{{ path('app_project_show', {id: project.id}) }}">← {{ project.address }}</a>
  <div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2 mb-1">Factures</h1><p class="text-muted">Facturation progressive par jalon</p></div>{% if canManageInvoices %}<a class="btn btn-primary" href="{{ path('app_invoice_new', {id: project.id}) }}">Générer une facture</a>{% endif %}</div>
  {% if isReadOnly %}<p role="status" class="alert alert-warning">Ce dossier est en lecture seule. Un forfait actif est requis pour modifier la facturation.</p>{% endif %}
  <div class="card mb-4"><div class="card-body"><dl class="row mb-0"><dt class="col-sm-4">Budget</dt><dd class="col-sm-8">{{ project.budget|number_format(2, ',', ' ') }} $</dd><dt class="col-sm-4">Facturé hors taxes</dt><dd class="col-sm-8">{{ taxSummary.subtotal|number_format(2, ',', ' ') }} $</dd><dt class="col-sm-4">Progression</dt><dd class="col-sm-8"><progress value="{{ project.budget > 0 ? (taxSummary.subtotal / project.budget * 100)|round : 0 }}" max="100">{{ project.budget > 0 ? (taxSummary.subtotal / project.budget * 100)|round : 0 }} %</progress></dd></dl></div></div>
  {% if project.invoices|length %}<div class="table-responsive"><table class="table"><thead><tr><th scope="col">Jalon</th><th scope="col">%</th><th scope="col">Montant HT</th><th scope="col">TPS (5 %)</th><th scope="col">TVQ (9,975 %)</th><th scope="col">Total TTC</th><th scope="col">Statut</th><th scope="col">Actions</th></tr></thead><tbody>{% for invoice in project.invoices %}{% set invoiceTax = invoice.amount|number_format(2, '.', '') %}<tr{% if invoice.status.value == 'overdue' %} class="table-danger"{% endif %}><td>{{ invoice.milestoneName }}</td><td>{{ invoice.percentage }} %</td><td>{{ invoice.amount|number_format(2, ',', ' ') }} $</td><td>{{ (invoiceTax * 0.05)|number_format(2, ',', ' ') }} $</td><td>{{ (invoiceTax * 0.09975)|number_format(2, ',', ' ') }} $</td><td>{{ (invoiceTax * 1.14975)|number_format(2, ',', ' ') }} $</td><td><twig:StatusBadge :status="invoice.status.value" :label="invoice.status.value|replace({'draft': 'Brouillon', 'sent': 'Envoyée', 'paid': 'Payée', 'overdue': 'En retard', 'cancelled': 'Annulée'})" /></td><td><a target="_blank" rel="noopener" href="{{ path('app_invoice_pdf', {id: project.id, invoiceId: invoice.id}) }}">Voir PDF</a>{% if canManageInvoices and invoice.status.value == 'draft' %}<form method="post" action="{{ path('app_invoice_status', {id: project.id, invoiceId: invoice.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('invoice-' ~ invoice.id) }}"><button name="status" value="sent" type="submit">Envoyer</button></form>{% elseif canManageInvoices and invoice.status.value == 'sent' %}<form method="post" action="{{ path('app_invoice_status', {id: project.id, invoiceId: invoice.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('invoice-' ~ invoice.id) }}"><button name="status" value="paid" type="submit">Marquer payée</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div><aside class="card ms-auto" style="max-width: 320px"><div class="card-body"><dl><dt>Sous-total</dt><dd>{{ taxSummary.subtotal|number_format(2, ',', ' ') }} $</dd><dt>TPS (5 %)</dt><dd>{{ taxSummary.tps|number_format(2, ',', ' ') }} $</dd><dt>TVQ (9,975 %)</dt><dd>{{ taxSummary.tvq|number_format(2, ',', ' ') }} $</dd><dt>Total TTC</dt><dd><strong>{{ taxSummary.total|number_format(2, ',', ' ') }} $</strong></dd></dl></div></aside>{% else %}<p class="text-muted">Aucune facture. Définissez des jalons pour générer des factures progressives.</p>{% endif %}
</section>
{% endblock %}
