{#
Billing success page.
Route: /facturation/succes (GET) — BillingController::success
#}
{% extends 'app_base.html.twig' %}
{% block breadcrumb %}Confirmation de l’abonnement{% endblock %}

{% block title %}Abonnement actif — SysGC{% endblock %}

{% block body %}
<div class="content-page confirmation-page">
    <div class="confirmation-mark" aria-hidden="true">✓</div>

    <h1>Merci ! Votre abonnement est actif.</h1>
    <p class="content-lead">
        Votre paiement a été traité avec succès. Vous pouvez maintenant profiter de toutes les fonctionnalités de votre forfait.
    </p>

    <a href="{{ path('app_dashboard') }}" class="btn btn-primary confirmation-action">
        Retour au tableau de bord
    </a>
</div>
{% endblock %}
