{#
Billing success page.
Route: /facturation/succes (GET) — BillingController::success
#}
{% extends 'layouts/app.html.twig' %}

{% block title %}Abonnement active — SysGC{% endblock %}

{% block body %}
<div class="mx-auto max-w-2xl px-4 py-20 text-center">
    <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-green-100">
        <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
    </div>

    <h1 class="text-2xl font-bold text-zinc-900">Merci ! Votre abonnement est actif.</h1>
    <p class="mt-4 text-sm text-zinc-600">
        Votre paiement a ete traite avec succes. Vous pouvez maintenant profiter de toutes les fonctionnalites de votre forfait.
    </p>

    <a href="{{ path('dashboard') }}" class="mt-8 inline-block rounded-md bg-zinc-900 px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-700">
        Retour au tableau de bord
    </a>
</div>
{% endblock %}
