{#
Billing upgrade page.
Route: /forfaits (GET/POST) — BillingController::upgrade / upgradePost
#}
{% extends 'app_base.html.twig' %}

{% block title %}Forfaits — SysGC{% endblock %}
{% block breadcrumb %}Forfaits{% endblock %}

{% block body %}
<div class="content-page content-page--wide">
    <h1>Choisir un forfait</h1>
    <p class="content-lead">Tous les forfaits incluent les fonctionnalités de base : gestion de chantiers, sécurité et conformité CCQ-RBQ.</p>

    {% if subscriptionStatus.value == 'grace' %}
        <div data-subscription-state="grace" class="mt-4">
            <h2 class="sr-only">Période de grâce</h2>
            <twig:AlertBanner type="warning" message="Votre abonnement est arrivé à échéance. Renouvelez-le dans les 7 jours pour éviter le mode lecture seule." actionLabel="Gérer mon abonnement" actionUrl="{{ path('app_billing_portal') }}" />
        </div>
    {% elseif subscriptionStatus.value == 'read_only' %}
        <div data-subscription-state="read_only" class="mt-4"><twig:AlertBanner type="error" message="Votre organisation est en lecture seule. Renouvelez votre abonnement pour réactiver les modifications." actionLabel="Renouveler" actionUrl="{{ path('app_billing_portal') }}" /></div>
    {% elseif subscriptionStatus.value == 'enterprise_required' %}
        <div data-subscription-state="enterprise_required" class="mt-4"><twig:AlertBanner type="warning" message="Votre équipe dépasse les limites Business. Contactez-nous pour un forfait Enterprise." actionLabel="Contacter Enterprise" actionUrl="{{ path('app_contact') }}" /></div>
    {% endif %}

    {% for flash_error in app.flashes('error') %}
        <div class="flash flash--error" role="alert">
            {{ flash_error }}
        </div>
    {% endfor %}

    {% for flash_info in app.flashes('info') %}
        <div class="flash flash--info" role="status">
            {{ flash_info }}
        </div>
    {% endfor %}

    <div class="plan-grid">
        {# Capture CSRF token once — it may only be rendered once. #}
        {% set csrfToken = form_widget(form._token) %}

        {% for tier in tiers %}
            {% set tierValue = tier.value %}
            {% set isCurrent = currentTier and currentTier.value == tierValue %}
            <div role="article" aria-label="Forfait {{ tier.label }}"{% if isCurrent %} aria-current="true"{% endif %} class="plan-card{{ isCurrent ? ' plan-card--current' : '' }}">
                <h2>{{ tier.label }}</h2>

                <p class="mt-2">
                    <span class="plan-card__price">{{ prices[tierValue] }}&nbsp;$</span>
                    <span class="content-muted">/mois</span>
                </p>

                <ul class="plan-card__features">
                    <li class="plan-card__feature">
                        <span aria-hidden="true">✓</span>
                        Jusqu’à {{ tier.workerLimit }} travailleurs
                    </li>
                    <li class="plan-card__feature">Jusqu’à {{ tier.userLimit }} utilisateurs</li>
                    <li class="plan-card__feature">
                        <span aria-hidden="true">✓</span>
                        TPS + TVQ calculées automatiquement
                    </li>
                    <li class="plan-card__feature">
                        <span aria-hidden="true">✓</span>
                        Facturation mensuelle
                    </li>
                </ul>

                <div class="plan-card__actions">
                    {% if isCurrent %}
                        <span class="plan-card__current">
                            Forfait actuel
                        </span>
                    {% else %}
                        <form method="post" action="{{ path('app_billing_upgrade_post') }}">
                            <input type="hidden" name="billing_plan[tier]" value="{{ tierValue }}">
                            {{ csrfToken|raw }}
                            <button type="submit" class="btn btn-primary plan-card__submit">
                                {{ tierValue == 'starter' ? 'Commencer' : 'Choisir ' ~ tier.label }}
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>

    {% if currentTier %}
        <p class="content-muted content-usage">Utilisation : {{ workerCount }}/{{ currentTier.workerLimit }} travailleurs · {{ userCount }}/{{ currentTier.userLimit }} utilisateurs.</p>
        <a class="mt-2 inline-block text-sm underline" href="{{ path('app_billing_portal') }}" aria-label="Gérer l'abonnement via Stripe">Gérer mon abonnement</a>
    {% endif %}
</div>
{% endblock %}
