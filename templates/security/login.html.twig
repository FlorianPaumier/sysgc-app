{% extends 'base.html.twig' %}

{% block title %}Connexion — SysGC{% endblock %}

{% form_theme form _self %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <div class="auth-field-error visible">
            {%- for error in errors -%}
                <span>{{ error.message }}</span>
            {%- endfor -%}
        </div>
    {% endif %}
{% endblock %}

{% block body %}
    <div class="auth-page">
        <div class="auth-card">
            <div class="auth-card-body">
                {# Branding #}
                <a href="{{ path('home') }}" class="auth-logo" aria-label="SysGC — Accueil">
                    <span class="auth-wordmark">SYS<span>GC</span></span>
                </a>
                <div class="auth-accent-line"></div>

                <h1 class="auth-heading">Connexion</h1>
                <p class="auth-subtitle">Recevez un lien de connexion sécurisé par courriel, sans mot de passe.</p>

                {# Flash errors #}
                {% for flash_error in app.flashes('error') %}
                    <div class="alert-banner alert-banner--error" role="alert">
                        <span class="alert-banner__icon" aria-hidden="true">!</span>
                        <div class="alert-banner__content">
                            <span class="alert-banner__message">{{ flash_error }}</span>
                        </div>
                    </div>
                {% endfor %}

                {# Authentication error #}
                {% if error %}
                    <div class="alert-banner alert-banner--error" role="alert">
                        <span class="alert-banner__icon" aria-hidden="true">!</span>
                        <div class="alert-banner__content">
                            <span class="alert-banner__message">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                        </div>
                    </div>
                {% endif %}

                {{ form_start(form, { attr: { class: 'auth-form' } }) }}
                    {% set email_has_error = form.email.vars.errors|length > 0 %}
                    <div class="auth-field-group">
                        {{ form_label(form.email, null, { label_attr: { class: 'auth-field-label' } }) }}
                        {{ form_widget(form.email, { attr: { class: 'auth-field-input' ~ (email_has_error ? ' error' : ''), placeholder: 'david@constructiondem.ca' } }) }}
                        {{ form_errors(form.email) }}
                    </div>

                    {{ form_widget(form.send, { attr: { class: 'auth-submit-btn' } }) }}
                {{ form_end(form) }}

                <p class="auth-footer-link">
                    Pas encore de compte&nbsp;? <a href="{{ path('register') }}">Inscrivez-vous</a>.
                </p>
            </div>
        </div>
    </div>
{% endblock %}
