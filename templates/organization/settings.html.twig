{#
Organization settings page.
Route: /organisation (GET/POST) — OrganizationController::settings
Extends the authenticated app shell so the sidebar is visible.
#}
{% extends 'layouts/app.html.twig' %}

{% block title %}Paramètres de l'organisation — SysGC{% endblock %}

{% block body %}
<div class="mx-auto max-w-2xl px-4 py-10">
    <h1 class="text-2xl font-bold text-zinc-900">Paramètres de l'organisation</h1>

    {% for flash_error in app.flashes('error') %}
        <div class="mt-4 rounded-md bg-red-50 p-3 text-sm text-red-700" role="alert">
            {{ flash_error }}
        </div>
    {% endfor %}

    {% for flash_success in app.flashes('success') %}
        <div class="mt-4 rounded-md bg-green-50 p-3 text-sm text-green-700" role="status">
            {{ flash_success }}
        </div>
    {% endfor %}

    {{ form_start(form, { attr: { class: 'mt-6 space-y-4' } }) }}
        {{ form_row(form.name, {
            row_attr: { class: 'space-y-1' },
            attr: { class: 'mt-1 block w-full rounded-md border-zinc-300 shadow-sm' },
        }) }}
        {{ form_row(form.rbqLicense, {
            row_attr: { class: 'space-y-1' },
            attr: { class: 'mt-1 block w-full rounded-md border-zinc-300 shadow-sm' },
        }) }}

        <fieldset class="mt-6 rounded-md border border-zinc-200 p-4">
            <legend class="text-sm font-semibold text-zinc-700">{{ form.address.vars.label }}</legend>
            <div class="mt-3 space-y-4">
                {{ form_row(form.address.street, {
                    row_attr: { class: 'space-y-1' },
                    attr: { class: 'mt-1 block w-full rounded-md border-zinc-300 shadow-sm' },
                }) }}
                {{ form_row(form.address.street2, {
                    row_attr: { class: 'space-y-1' },
                    attr: { class: 'mt-1 block w-full rounded-md border-zinc-300 shadow-sm' },
                }) }}
                <div class="grid grid-cols-2 gap-4">
                    {{ form_row(form.address.postalCode, {
                        row_attr: { class: 'space-y-1' },
                        attr: { class: 'mt-1 block w-full rounded-md border-zinc-300 shadow-sm' },
                    }) }}
                    {{ form_row(form.address.city, {
                        row_attr: { class: 'space-y-1' },
                        attr: { class: 'mt-1 block w-full rounded-md border-zinc-300 shadow-sm' },
                    }) }}
                </div>
                <div class="grid grid-cols-2 gap-4">
                    {{ form_row(form.address.state, {
                        row_attr: { class: 'space-y-1' },
                        attr: { class: 'mt-1 block w-full rounded-md border-zinc-300 shadow-sm' },
                    }) }}
                    {{ form_row(form.address.country, {
                        row_attr: { class: 'space-y-1' },
                        attr: { class: 'mt-1 block w-full rounded-md border-zinc-300 shadow-sm' },
                    }) }}
                </div>
            </div>
        </fieldset>

        {{ form_row(form.save, {
            attr: { class: 'w-full rounded-md bg-zinc-900 px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-700' },
        }) }}
    {{ form_end(form) }}

    <section aria-labelledby="plan-heading" class="mt-10 rounded-md border border-zinc-200 p-6">
        <h2 id="plan-heading" class="text-lg font-semibold text-zinc-900">Forfait</h2>
        <dl class="mt-4 space-y-3 text-sm text-zinc-700">
            <div class="flex justify-between">
                <dt class="font-medium">Forfait</dt>
                <dd>{{ organization.subscriptionTier ? organization.subscriptionTier.label : '—' }}</dd>
            </div>
            <div class="flex justify-between">
                <dt class="font-medium">Limite de travailleurs</dt>
                <dd>{{ organization.subscriptionTier ? organization.subscriptionTier.workerLimit ~ ' travailleurs inclus' : '—' }}</dd>
            </div>
        </dl>
        {# Wire to path('billing_portal') when BillingController lands (specs/05-routes-templates.md). #}
        <a href="#" class="mt-4 inline-block text-sm font-medium text-zinc-900 underline hover:text-zinc-700">
            Gérer mon abonnement
        </a>
    </section>
</div>
{% endblock %}
