{% extends 'app_base.html.twig' %}

{% block title %}Déclaration CCQ — SysGC{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_project_show', {id: project.id}) }}">{{ project.address }}</a> <span aria-hidden="true">/</span> Déclaration CCQ{% endblock %}
{% block body %}
<div class="mx-auto max-w-7xl px-4 py-8">
    <header class="dashboard-head"><div><h1>Déclaration CCQ</h1><p>{{ project.address }} · {{ currentMonth }}/{{ currentYear }}</p></div></header>
    <twig:CcqGrid :project="project" :month="currentMonth" :year="currentYear" />
</div>
{% endblock %}
