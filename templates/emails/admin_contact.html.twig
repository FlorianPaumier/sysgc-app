{# Admin notification — new contact form submission #}
{% extends 'emails/base.html.twig' %}

{% block subject %}Nouveau contact — {{ subject }}{% endblock %}

{% block content %}
    <p style="font-family:'Saira Condensed','Trebuchet MS','Arial Narrow',-apple-system,sans-serif;font-size:13px;font-weight:600;letter-spacing:0.08em;color:#B5AC97;text-transform:uppercase;margin:0 0 8px;">
        Formulaire de contact
    </p>
    <h3 style="margin:0 0 24px;">Nouveau message reçu</h3>

    {# ─── Sender card ─── #}
    <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #D6CDB6;border-radius:6px;margin:0 0 24px;">
        <tr>
            <td style="padding:10px 16px;font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,sans-serif;font-size:13px;color:#6B665C;border-bottom:1px solid #D6CDB6;">
                <strong style="color:#3D3A35;font-weight:600;">De</strong>
            </td>
            <td style="padding:10px 16px;font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,sans-serif;font-size:13px;color:#17161A;border-bottom:1px solid #D6CDB6;">
                {{ name }}
            </td>
        </tr>
        <tr>
            <td style="padding:10px 16px;font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,sans-serif;font-size:13px;color:#6B665C;border-bottom:1px solid #D6CDB6;">
                <strong style="color:#3D3A35;font-weight:600;">Courriel</strong>
            </td>
            <td style="padding:10px 16px;font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,sans-serif;font-size:13px;color:#17161A;border-bottom:1px solid #D6CDB6;">
                {{ from }}
            </td>
        </tr>
        <tr>
            <td style="padding:10px 16px;font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,sans-serif;font-size:13px;color:#6B665C;">
                <strong style="color:#3D3A35;font-weight:600;">Sujet</strong>
            </td>
            <td style="padding:10px 16px;font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,sans-serif;font-size:13px;color:#17161A;">
                {{ subject }}
            </td>
        </tr>
    </table>

    {# ─── Message block ─── #}
    <p style="font-family:'Saira Condensed','Trebuchet MS','Arial Narrow',-apple-system,sans-serif;font-size:13px;font-weight:600;letter-spacing:0.08em;color:#B5AC97;text-transform:uppercase;margin:0 0 8px;">
        Message
    </p>
    <div style="background:#F1ECDF;border:1px solid #D6CDB6;border-radius:6px;padding:16px 20px;margin:0 0 24px;font-family:'IBM Plex Mono','SF Mono','Monaco','Courier New',monospace;font-size:13px;line-height:1.7;color:#17161A;white-space:pre-wrap;">
        {{ message }}
    </div>

    <p class="text-small text-muted" style="font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,sans-serif;font-size:12px;color:#B5AC97;">
        Envoyé via le formulaire de contact du site SysGC.
    </p>
{% endblock %}
