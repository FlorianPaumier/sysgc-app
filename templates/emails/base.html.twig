{% apply inline_css(source("@styles/email/app.css")) %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block subject %}{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@600;700&family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body style="margin:0;padding:0;background:#F1ECDF;font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#17161A;">
    <table width="100%" cellpadding="0" cellspacing="0" style="padding:32px 16px;">
        <tr>
            <td align="center">
                <table width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #D6CDB6;">

                    {# ─── Header / Brand ─── #}
                    <tr>
                        <td style="padding:28px 32px 20px;background:#ffffff;">
                            <div style="font-family:'Saira Condensed','Trebuchet MS','Arial Narrow',-apple-system,sans-serif;font-size:22px;font-weight:700;letter-spacing:0.04em;color:#17161A;">
                                SYS<span style="color:#F47920;">GC</span>
                            </div>
                            <div style="width:48px;height:3px;background-color:#F47920;margin-top:10px;"></div>
                        </td>
                    </tr>

                    {# ─── Content ─── #}
                    <tr>
                        <td style="padding:8px 32px 32px;">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>

                    {# ─── Footer ─── #}
                    <tr>
                        <td style="padding:16px 32px;background:#F1ECDF;border-top:1px solid #D6CDB6;font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,sans-serif;font-size:12px;color:#6B665C;line-height:1.6;">
                            {% block footer %}
                                Courriel envoyé automatiquement — merci de ne pas y répondre.<br>
                                <span style="color:#B5AC97;">SysGC · Construit au Québec · Hébergé au Québec</span>
                            {% endblock %}
                        </td>
                    </tr>

                </table>

                {# ─── Sub-footer ─── #}
                <table width="560" cellpadding="0" cellspacing="0">
                    <tr>
                        <td style="padding:16px 0 0;text-align:center;font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,sans-serif;font-size:11px;color:#B5AC97;">
                            SysGC — Conformité CCQ · RBQ · CNESST
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
{% endapply %}
