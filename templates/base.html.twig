<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#F1ECDF">
    <meta name="description" content="Déclarations CCQ, vérification RBQ, registres CNESST, avenants et facturation — réunis dans un seul système.">
    <meta property="og:title" content="{% block og_title %}SysGC — Conformité CCQ · RBQ · CNESST{% endblock %}">
    <meta property="og:description" content="Déclarations CCQ, vérification RBQ, registres CNESST — réunis dans un seul système. Construit au Québec pour les entrepreneurs.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ app.request.schemeAndHttpHost }}">
    <meta property="og:image" content="{{ absolute_url(asset('favicon.svg')) }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{% block twitter_title %}SysGC{% endblock %}">
    <meta name="twitter:description" content="Déclarations CCQ, vérification RBQ, registres CNESST — réunis dans un seul système.">
    <link rel="manifest" href="{{ asset('manifest.json') }}">
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
    <link rel="alternate icon" href="{{ asset('favicon.ico') }}" sizes="any">
    <link rel="apple-touch-icon" href="{{ asset('favicon.svg') }}">
    <title>{% block title %}SysGC — Conformité CCQ · RBQ · CNESST{% endblock %}</title>
    
    {# Google Fonts — Saira Condensed, IBM Plex Sans, IBM Plex Mono #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
        rel="stylesheet"
    >
    
    {% block stylesheets %}
        {# Logical asset path (AssetMapper public prefix is /assets) — served
           digested + compiled by the TailwindCssAssetCompiler. #}
        <link rel="stylesheet" href="{{ asset('styles/global.css') }}">
    {% endblock %}
    
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
    
    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph" crossorigin="anonymous"></script>
        <script
            src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm"
            type="module"
            crossorigin="anonymous"
        ></script>
    {% endif %}
</head>
<body>
<a href="#main" class="skip">Aller au contenu principal</a>
{% embed 'components/partials/_nav.html.twig' %}
    {% block nav_links %}
        <li><a href="#modules">Modules</a></li>
        <li><a href="#howto">Fonctionnement</a></li>
        <li><a href="#pricing">Forfaits</a></li>
        <li><a href="#faq">FAQ</a></li>
        <li><a href="{{ path('app_contact') }}">Contact</a></li>
    {% endblock %}
{% endembed %}
{% block layout %}
    {# Default page layout: a single main column with an optional aside.
       The authenticated app shell (templates/layouts/app.html.twig) overrides
       this block to add the desktop sidebar + mobile bottom nav. #}
    <div class="layout">
        <main id="main" tabindex="-1">
            {% block body %}{% endblock %}
        </main>
        {% block aside %}{% endblock %}
    </div>
{% endblock %}
<footer id="contact">
    <div class="wrap">
        <div class="foot-grid">
            <div>
                <div class="foot-brand">SYS<span class="gc">GC</span></div>
                <div class="foot-tag">Construit au Québec — pour les entrepreneurs du Québec</div>
            </div>
            <ul class="foot-links">
                <li><a href="{{ path('home') }}">Contact</a></li>
                <li><a href="{{ path('home') }}">Confidentialité</a></li>
                <li><a href="{{ path('home') }}">Conditions</a></li>
            </ul>
        </div>
        <div class="foot-bottom">
            <span>© {{ 'now'|date('Y') }} SysGC — Tous droits réservés.</span>
            <span>Hébergé au Québec · Loi 25 · SOC 2 Type II</span>
        </div>
    </div>
</footer>
</body>
</html>
