{% extends 'app_base.html.twig' %}

{% block title %}Travailleurs — SysGC{% endblock %}
{% block breadcrumb %}Travailleurs{% endblock %}

{% block body %}
    <div class="mx-auto max-w-5xl px-4 py-8">
    <header class="dashboard-head">
        <h1>Travailleurs</h1>
        <p>Gérez les métiers et régions CCQ de votre équipe.</p>
        <a class="btn btn-primary" href="{{ path('app_worker_new') }}">+ Nouveau travailleur</a>
    </header>

    <table class="table">
        <caption class="sr-only">Liste des travailleurs et leurs classifications CCQ</caption>
        <thead>
            <tr>
                <th scope="col">Nom</th>
                <th scope="col">Métier CCQ</th>
                <th scope="col">Région</th>
                <th scope="col"><span class="sr-only">Actions</span></th>
            </tr>
        </thead>
        <tbody>
        {% for worker in workers %}
            <tr>
                <td>{{ worker.name }}</td>
                <td>{{ worker.ccqTrade.label }}</td>
                <td>{{ worker.ccqRegion.label }}</td>
                <td>
                    <a href="{{ path('app_worker_edit', {'id': worker.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Aucun travailleur. Ajoutez des travailleurs pour remplir les déclarations CCQ.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    </div>
{% endblock %}
