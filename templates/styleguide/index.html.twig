{% extends 'layouts/app.html.twig' %}

{% block title %}Guide de styles — SysGC{% endblock %}

{% block body %}
<div class="container" style="padding: 2rem 1.5rem;">
    <header class="dashboard-head">
        <span class="section-tag">Système de design</span>
        <h1>Guide de styles</h1>
        <p>Tokens, composants d'état et coquille de l'application.</p>
    </header>

    <section style="margin-top: 2rem;">
        <h2 class="label" style="font-size: 0.8rem; margin-bottom: 0.75rem;">Boutons</h2>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <a class="btn btn-primary" href="#">Action principale</a>
            <a class="btn btn-ghost" href="#">Action secondaire</a>
        </div>
    </section>

    <section style="margin-top: 2.5rem;">
        <h2 class="label" style="font-size: 0.8rem; margin-bottom: 0.75rem;">États</h2>

        <h3 style="font-family: var(--font-display); font-size: 1.25rem; margin: 1rem 0 .5rem;">Chargement</h3>
        <p><twig:Spinner size="md" /></p>

        <h3 style="font-family: var(--font-display); font-size: 1.25rem; margin: 1.5rem 0 .5rem;">Vide</h3>
        <twig:EmptyState
            icon="🏗️"
            title="Aucun chantier"
            description="Ajoutez votre premier chantier pour commencer."
            actionLabel="Nouveau chantier"
            actionUrl="#" />

        <h3 style="font-family: var(--font-display); font-size: 1.25rem; margin: 1.5rem 0 .5rem;">Alerte</h3>
        <twig:AlertBanner
            type="error"
            message="3 erreurs détectées dans la déclaration CCQ."
            dismissible="true" />
    </section>

    <section style="margin-top: 2.5rem;">
        <h2 class="label" style="font-size: 0.8rem; margin-bottom: 0.75rem;">Date</h2>
        <p>Format Québec (JJ/MM/AAAA) : <strong>{{ '2026-07-28'|qdate }}</strong></p>
    </section>
</div>
{% endblock %}

{% block aside %}
<aside class="page-aside">
    <span class="label">Aperçu</span>
    <p style="margin-top: .5rem;">Colonne secondaire optionnelle — visible uniquement sur grand écran (tableau de bord).</p>
</aside>
{% endblock %}
