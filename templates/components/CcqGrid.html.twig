<section class="ccq-grid" {{ attributes.defaults({class: 'card'}) }} data-testid="ccq-grid"{% if exporting %} aria-busy="true" data-live-poll="3000"{% endif %}>
    <div class="ccq-grid__toolbar">
        <div><p class="eyebrow">Organisation · période</p><strong>{{ '%02d'|format(month) }}/{{ year }}</strong></div>
        <div class="ccq-rule-meta"><span>Règles actives</span> <strong>{{ ruleVersion }}</strong></div>
    </div>
    <div class="ccq-statuses" data-testid="ccq-statuses" aria-label="Cycle de la déclaration">
        {% for lifecycle in ['draft', 'validated', 'exported', 'filed'] %}
            <twig:StatusBadge :status="lifecycle" :label="lifecycle == 'draft' ? 'Brouillon' : (lifecycle == 'validated' ? 'Validée' : (lifecycle == 'exported' ? 'Exportée' : 'Déposée'))" />
        {% endfor %}
    </div>
    {% if hoursData is empty %}
        <twig:EmptyState title="Aucune heure à déclarer" message="Ajoutez des heures aux travailleurs de ce chantier pour préparer la déclaration." />
    {% endif %}
        <div class="table-wrap ccq-grid__scroll"><table><caption class="sr-only">Heures CCQ par travailleur et par semaine</caption><thead><tr><th scope="col" data-sticky="identity">Travailleur</th><th scope="col">Chantier</th><th scope="col">Métier / région</th>{% for week in 1..5 %}<th scope="col">Semaine {{ week }}</th>{% endfor %}<th scope="col">Total</th></tr></thead><tbody>
        {% for row in hoursData %}{% set rowIndex = loop.index0 %}{% set rowErrors = validationErrors|filter(error => error.workerId is not null and error.workerId == row.workerId) %}<tr><th scope="row" data-sticky="identity"><strong>{{ row.workerName }}</strong><small>{{ row.projectAddress|default('') }}</small>{% for error in rowErrors %}<span id="ccq-error-{{ rowIndex }}-{{ loop.index0 }}" class="ccq-inline-error" role="alert">{{ error.message }}</span>{% endfor %}</th><td>{{ row.projectName|default('—') }}</td><td>{{ row.trade.label|default(row.trade|default('—')) }}<small>{{ row.region.label|default(row.region|default('—')) }}</small></td>{% for week in 1..5 %}<td><input type="number" min="0" step="0.5" data-model="hoursData.{{ rowIndex }}.week{{ week }}Hours" value="{{ attribute(row, 'week' ~ week ~ 'Hours')|default(0) }}" aria-label="Heures de {{ row.workerName }}, semaine {{ week }}"{% if rowErrors %} aria-describedby="{% for error in rowErrors %}ccq-error-{{ rowIndex }}-{{ loop.index0 }}{% if not loop.last %} {% endif %}{% endfor %}"{% endif %}></td>{% endfor %}<td class="ccq-grid__worker-total">{{ this.totalFor(row) }} h</td></tr>{% endfor %}
        </tbody><tfoot data-sticky="totals"><tr><th scope="row" colspan="3">TOTAUX ORGANISATION</th>{% for week in 1..5 %}<td>{{ this.weekTotal(week) }} h</td>{% endfor %}<td>{{ this.grandTotal() }} h</td></tr></tfoot></table></div>
    <div class="form-actions"><button class="btn" data-action="live#action" data-live-action-param="validate" type="button">Valider</button>{% if validated and this.canExport() and not exporting %}<button class="btn" data-action="live#action" data-live-action-param="exportPdf" type="button" aria-label="Exporter la déclaration en PDF">Exporter le PDF</button>{% endif %}{% if status == 'exported' and not exporting %}<button class="btn" data-action="live#action" data-live-action-param="prepareFiling" type="button">Confirmer le dépôt manuel</button>{% endif %}</div>
    <div id="ccq-validation" aria-live="polite">{% if exporting %}<twig:Spinner size="sm" /><span>Génération du PDF en cours…</span><button class="btn" data-action="live#action" data-live-action-param="refreshExportStatus" type="button">Actualiser l’état de l’exportation</button>{% elseif validated and validationErrors is empty %}<twig:AlertBanner type="success" message="Déclaration valide." />{% endif %}{% for error in validationErrors %}<twig:AlertBanner :type="error.warning ? 'warning' : 'error'" :message="'[' ~ error.code ~ '] ' ~ error.message" />{% endfor %}</div>
    {% if validated and validationErrors|filter(error => error.warning)|length > 0 and not exporting %}<div class="ccq-warning-acknowledgement"><label for="ccq-warning-ack">Expliquez la prise en compte des avertissements</label><textarea id="ccq-warning-ack" data-model="warningAcknowledgement" required>{{ warningAcknowledgement }}</textarea><button class="btn" data-action="live#action" data-live-action-param="acknowledgeWarnings" type="button">Acquitter les avertissements</button></div>{% endif %}
    {% if filingConfirmationOpen %}<twig:Modal id="ccq-filing-confirmation" title="Confirmer le dépôt manuel" open="true"><p>Le PDF exporté a été transmis à la CCQ hors ligne. Confirmez-vous le dépôt de cette déclaration?</p>{% block actions %}<button class="btn" data-action="live#action" data-live-action-param="fileDeclaration" type="button">Oui, confirmer le dépôt</button>{% endblock %}</twig:Modal>{% endif %}
</section>
