<div {{ attributes }}>
    <h1>{{ 'welcome.title'|trans }}</h1>
    <p>{{ 'welcome.subtitle'|trans }}</p>

    <p>
        <button
            type="button"
            data-action="live#action"
            data-live-action-param="increment"
        >
            {{ 'welcome.visits'|trans }} : {{ visits }}
        </button>
    </p>
</div>
