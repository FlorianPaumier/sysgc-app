{#
EmptyState — empty-list state with optional CTA (specs/06-frontend.md).
Usage:
    <twig:EmptyState icon="🏗️" title="Aucun chantier"
        description="Ajoutez votre premier chantier pour commencer."
        actionLabel="Nouveau chantier" actionUrl="/chantiers/nouveau" />
#}
{% props icon = '📋', title = '', description = '', message = '', actionLabel = '', actionUrl = '' %}

{% set description = description ?: message %}

<div class="empty-state" role="status">
    <div class="empty-state__icon" aria-hidden="true">{{ icon }}</div>
    {% if title %}<h2 class="empty-state__title">{{ title }}</h2>{% endif %}
    {% if description %}<p class="empty-state__desc">{{ description }}</p>{% endif %}
    {% if actionLabel and actionUrl %}
        <a class="btn btn-primary empty-state__cta" href="{{ actionUrl }}">{{ actionLabel }}</a>
    {% endif %}
</div>
