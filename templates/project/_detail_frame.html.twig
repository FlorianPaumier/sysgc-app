<turbo-frame id="project-detail" class="project-detail__frame" tabindex="-1">
    <twig:TabBar :tabs="tabs" :activeTab="activeTab" label="Détails du chantier" />
    {% if activeTab == 'overview' %}
        <section class="project-panel" aria-labelledby="project-overview-title">
            <div class="project-panel__heading"><div><p class="project-panel__eyebrow">Vue d’ensemble</p><h2 id="project-overview-title">Repères du chantier</h2></div>{% if not isArchived %}<a class="btn" href="{{ path('app_project_edit', {id: project.id}) }}" data-turbo-frame="_top">Modifier</a>{% endif %}</div>
            <dl class="project-facts"><div><dt>Début</dt><dd>{{ project.startDate ? project.startDate|date('Y-m-d') : 'À confirmer' }}</dd></div><div><dt>Fin prévue</dt><dd>{{ project.endDate ? project.endDate|date('Y-m-d') : 'En cours' }}</dd></div><div><dt>Budget</dt><dd>{{ project.budget|number_format(2, ',', ' ') }} $</dd></div><div><dt>Responsables terrain</dt><dd>{{ project.assignedForemen|length ?: 'Aucun' }}</dd></div></dl>
            {% if not isArchived %}<form class="project-archive" method="post" action="{{ path('app_project_archive', {id: project.id}) }}" data-turbo-frame="_top"><input type="hidden" name="_token" value="{{ csrf_token('archive-' ~ project.id) }}"><button class="btn" type="submit">Archiver le chantier</button><p>Le dossier restera consultable dans les archives.</p></form>{% endif %}
        </section>
    {% elseif activeTab == 'conformite' %}
        <section class="project-panel" aria-labelledby="project-compliance-title"><div class="project-panel__heading"><div><p class="project-panel__eyebrow">Conformité</p><h2 id="project-compliance-title">Dossiers réglementaires</h2></div></div><div class="project-summary-grid"><article><span>CCQ</span><strong>{{ project.ccqDeclarations|length }} déclaration(s)</strong>{% if not isArchived %}<a href="{{ path('app_ccq_declaration', {id: project.id}) }}" data-turbo-frame="_top">Ouvrir la déclaration →</a>{% endif %}</article><article><span>RBQ</span><strong>{{ project.subcontractors|length }} sous-traitant(s)</strong><a href="{{ path('app_rbq_index', {id: project.id}) }}" data-turbo-frame="_top">Voir les vérifications →</a></article></div></section>
    {% elseif activeTab == 'securite' %}
        <section class="project-panel" aria-labelledby="project-safety-title"><div class="project-panel__heading"><div><p class="project-panel__eyebrow">Sécurité</p><h2 id="project-safety-title">Rapports quotidiens</h2></div></div><div class="project-summary-callout"><strong>{{ project.safetyLogs|length }}</strong><span>rapport(s) conservé(s) pour ce chantier</span><a class="btn btn-primary" href="{{ path('app_safety_index', {id: project.id}) }}" data-turbo-frame="_top">Ouvrir le registre</a></div></section>
    {% elseif activeTab == 'finances' %}
        <section class="project-panel" aria-labelledby="project-finance-title"><div class="project-panel__heading"><div><p class="project-panel__eyebrow">Finances</p><h2 id="project-finance-title">Suivi commercial</h2></div></div><div class="project-summary-grid"><article><span>Avenants</span><strong>{{ project.changeOrders|length }} dossier(s)</strong><a href="{{ path('app_change_order_index', {id: project.id}) }}" data-turbo-frame="_top">Voir les avenants →</a></article><article><span>Factures</span><strong>{{ project.invoices|length }} facture(s)</strong><a href="{{ path('app_invoice_index', {id: project.id}) }}" data-turbo-frame="_top">Voir les factures →</a></article></div></section>
    {% else %}
        <section class="project-panel" aria-labelledby="project-documents-title"><div class="project-panel__heading"><div><p class="project-panel__eyebrow">Documents</p><h2 id="project-documents-title">Pièces du chantier</h2></div></div><twig:EmptyState icon="▤" title="Aucun document centralisé" description="Les exports réglementaires et financiers restent accessibles depuis leurs sections respectives." /></section>
    {% endif %}
</turbo-frame>
